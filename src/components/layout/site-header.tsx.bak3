"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { Logo } from "@/components/brand/logo";
import { Logo } from "@/components/brand/logo";
import { SmartSearch } from "@/components/layout/smart-search";
import { CountBadge, useShopCounts } from "@/components/layout/header-badges";
import {
  Heart,
  GitCompareArrows,
  ShoppingCart,
  History,
  Menu,
  X,
  Sun,
  Moon,
  UserRound,
} from "lucide-react";
import { cn } from "@/lib/utils";

const MAIN_NAV = [
  { href: "/", label: "خانه" },
  { href: "/products", label: "فروشگاه" },
  { href: "/products?view=categories", label: "دسته‌بندی‌ها" },
  { href: "/products?view=brands", label: "برندها" },
  { href: "/products?sale=1", label: "فروش ویژه" },
];

const EXTRA_NAV = [
  { href: "/about", label: "درباره ما" },
  { href: "/contact", label: "تماس با ما" },
];

function ThemeToggle() {
  const [dark, setDark] = useState(false);

  useEffect(() => {
    const root = document.documentElement;
    const stored = localStorage.getItem("theme");
    const isDark =
      stored === "dark" ||
      (!stored && root.classList.contains("dark"));
    setDark(isDark);
    root.classList.toggle("dark", isDark);
  }, []);

  function toggle() {
    const next = !dark;
    setDark(next);
    document.documentElement.classList.toggle("dark", next);
    localStorage.setItem("theme", next ? "dark" : "light");
  }

  return (
    <button
      type="button"
      onClick={toggle}
      className="border-border hover:bg-muted relative rounded-full border bg-background p-2"
      title={dark ? "حالت لایت" : "حالت دارک"}
      aria-label="تغییر تم"
    >
      {dark ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4" />}
    </button>
  );
}

function HeaderIcons() {
  const counts = useShopCounts();
  const item =
    "border-border hover:bg-muted relative rounded-full border bg-background p-2";

  return (
    <div className="flex items-center gap-1.5">
      <Link href="/dashboard" className={item} title="علاقه‌مندی‌ها">
        <Heart className="h-4 w-4" />
        <CountBadge count={counts.wishlist} />
      </Link>
      <Link href="/dashboard" className={item} title="مقایسه">
        <GitCompareArrows className="h-4 w-4" />
        <CountBadge count={counts.compare} />
      </Link>
      <Link href="/dashboard" className={item} title="بازدیدهای اخیر">
        <History className="h-4 w-4" />
        <CountBadge count={counts.recent} />
      </Link>
      <ThemeToggle />
      <Link href="/dashboard" className={item} title="سبد خرید">
        <ShoppingCart className="h-4 w-4" />
        <CountBadge count={counts.cart} />
      </Link>
    </div>
  );
}

export function SiteHeader({ className }: { className?: string }) {
  const [open, setOpen] = useState(false);
  const [trackCode, setTrackCode] = useState("");

  function submitTrack(e: React.FormEvent) {
    e.preventDefault();
    const code = trackCode.trim();
    if (!code) return;
    window.location.href = `/dashboard?track=${encodeURIComponent(code)}`;
    setOpen(false);
  }

  return (
    <header
      className={cn(
        "border-border bg-background/95 sticky top-0 z-50 border-b backdrop-blur",
        className
      )}
      dir="rtl"
    >
      {/* ========== دسکتاپ: همه در یک خط ========== */}
      <div className="mx-auto hidden h-16 max-w-7xl items-center gap-3 px-4 lg:flex">
        {/* لوگو */}
        <div className="shrink-0">
          <Link href="/" className="flex shrink-0 items-center" aria-label="خانه">
          <Logo size="lg" className="pointer-events-none" />
        </Link>
        </div>

        {/* منو */}
        <nav className="flex shrink-0 items-center gap-0.5">
          {MAIN_NAV.map((item) => (
            <Link
              key={item.label}
              href={item.href}
              className="text-muted-foreground hover:text-foreground whitespace-nowrap rounded-lg px-2 py-1.5 text-sm"
            >
              {item.label}
            </Link>
          ))}
        </nav>

        {/* سرچ */}
        <div className="min-w-0 flex-1">
          <SmartSearch />
        </div>

        {/* آیکون‌ها */}
        <HeaderIcons />

        {/* فقط ورود */}
        <Link
          href="/login"
          className="border-border hover:bg-muted inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm"
        >
          <UserRound className="h-4 w-4" />
          ورود
        </Link>
      </div>

      {/* ========== موبایل / تبلت ========== */}
      <div className="mx-auto flex h-14 max-w-7xl items-center gap-2 px-3 lg:hidden">
        <button
          type="button"
          className="border-border hover:bg-muted rounded-full border p-2"
          aria-label="منو"
          onClick={() => setOpen(true)}
        >
          <Menu className="h-5 w-5" />
        </button>

        <div className="min-w-0 flex-1">
          <SmartSearch />
        </div>

        <Link
          href="/login"
          className="border-border hover:bg-muted inline-flex shrink-0 items-center gap-1 rounded-full border px-3 py-1.5 text-sm"
        >
          <UserRound className="h-4 w-4" />
          ورود
        </Link>
      </div>

      {/* Drawer موبایل */}
      {open ? (
        <div className="fixed inset-0 z-[60] lg:hidden" dir="rtl">
          <button
            type="button"
            className="absolute inset-0 bg-black/40"
            aria-label="بستن"
            onClick={() => setOpen(false)}
          />
          <div className="border-border bg-background absolute top-0 right-0 flex h-full w-[min(100%,22rem)] flex-col border-l shadow-xl">
            <div className="border-border flex items-center justify-between border-b px-4 py-3">
              <span className="font-bold">منو</span>
              <button
                type="button"
                className="rounded-full p-2 hover:bg-muted"
                onClick={() => setOpen(false)}
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            <div className="flex-1 space-y-4 overflow-y-auto p-4">
              {/* ۱) آیکون‌ها در یک خط */}
              <div>
                <p className="text-muted-foreground mb-2 text-xs">دسترسی سریع</p>
                <HeaderIcons />
              </div>

              {/* ۲) ورود */}
              <Link
                href="/login"
                onClick={() => setOpen(false)}
                className="bg-primary text-primary-foreground flex w-full items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-medium"
              >
                <UserRound className="h-4 w-4" />
                ورود
              </Link>

              {/* ۳) منوی اصلی */}
              <nav className="space-y-1">
                {MAIN_NAV.map((item) => (
                  <Link
                    key={item.label}
                    href={item.href}
                    onClick={() => setOpen(false)}
                    className="hover:bg-muted block rounded-xl px-3 py-2.5 text-sm"
                  >
                    {item.label}
                  </Link>
                ))}
              </nav>

              {/* ۴) پیگیری سفارش */}
              <form onSubmit={submitTrack} className="space-y-2 rounded-xl border border-border p-3">
                <label className="text-sm font-medium">پیگیری سفارش</label>
                <input
                  value={trackCode}
                  onChange={(e) => setTrackCode(e.target.value)}
                  placeholder="کد رهگیری"
                  className="border-input bg-background h-10 w-full rounded-lg border px-3 text-sm text-right"
                  dir="rtl"
                />
                <button
                  type="submit"
                  className="bg-secondary text-secondary-foreground h-10 w-full rounded-lg text-sm font-medium"
                >
                  پیگیری
                </button>
              </form>

              {/* ۵) درباره / تماس */}
              <nav className="space-y-1 border-t border-border pt-3">
                {EXTRA_NAV.map((item) => (
                  <Link
                    key={item.label}
                    href={item.href}
                    onClick={() => setOpen(false)}
                    className="hover:bg-muted block rounded-xl px-3 py-2.5 text-sm"
                  >
                    {item.label}
                  </Link>
                ))}
              </nav>
            </div>
          </div>
        </div>
      ) : null}
    </header>
  );
}

export default SiteHeader;
